# Browser DSN for crash-lab buttons (Sentry → Settings → Projects → Client Keys)
VITE_SENTRY_DSN=

# Optional. Defaults to VITE_SENTRY_DSN for CLI and UI generator events.
SENTRY_DSN=

# Sentry API token for issue lookup, resolve, and assign.
# Settings → Auth Tokens. Scopes: event:read, event:write, project:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# User email or user:<id> for assigned Sentry issues
SENTRY_ASSIGNEE=

# Optional self-hosted Sentry URL. Defaults to https://sentry.io
# SENTRY_URL=

# Jira Cloud
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Account ID for assigned Jira issues (Profile → Account ID)
JIRA_ASSIGNEE_ACCOUNT_ID=
